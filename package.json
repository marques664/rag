{
  "name": "enterprise-knowledge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Enterprise Knowledge AI platform with RAG, asynchronous document ingestion, and PostgreSQL/pgvector.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @enterprise-ai/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "db:generate": "pnpm --filter @enterprise-ai/database db:generate",
    "db:migrate": "pnpm --filter @enterprise-ai/database db:migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
