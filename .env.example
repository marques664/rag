# Application
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info

# Authentication (JWT)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_knowledge_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_knowledge_ai?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_knowledge_ai_test?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=enterprise-knowledge-documents
