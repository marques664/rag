# Application
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info

# Authentication (JWT)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_knowledge_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_knowledge_ai?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_knowledge_ai_test?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=enterprise-knowledge-documents

# Document Upload & Worker Processing
MAX_DOCUMENT_FILE_SIZE_BYTES=26214400
WORKER_CONCURRENCY=3
WORKER_MAX_ATTEMPTS=3

# AI & Core RAG (Split LLM/Embedding defaults: Groq LLM + lexical FTS; enable gemini/openai/ollama for hybrid vector search)
AI_LLM_PROVIDER=groq
AI_EMBEDDING_PROVIDER=none
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Optional Google Gemini (set AI_EMBEDDING_PROVIDER=gemini or AI_LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_CHAT_MODEL=gemini-2.5-flash

AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_MS=500
AI_EMBEDDING_BATCH_SIZE=64
RAG_DEFAULT_TOP_K=5
RAG_MAX_CONTEXT_CHARS=24000
RAG_RETRIEVAL_STRATEGY=lexical

# Optional OpenAI Provider (when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional Local Ollama Provider (when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=1536
OLLAMA_CHAT_MODEL=llama3.1

# Security, CORS & Rate Limiting
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
